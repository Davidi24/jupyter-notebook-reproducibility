:map_pipeline_run_has_execution_000 rml:logicalSource :source_001 ;
	rdf:type rr:TriplesMap ;
	rdfs:label "pipeline_run_has_execution" ;
	rr:subjectMap :s_001 ;
	rr:predicateObjectMap :pom_013 .

:source_001 rdf:type rml:LogicalSource ;
	rml:source "pipeline_data/notebook_executions.csv" ;
	rml:referenceFormulation ql:CSV .

:s_001 rdf:type rr:SubjectMap ;
	rr:template "https://w3id.org/notebookfair/run/{repository_run_id}" .

:pom_013 rdf:type rr:PredicateObjectMap ;
	rr:predicateMap :pm_013 ;
	rr:objectMap :om_013 .

:pm_013 rdf:type rr:PredicateMap ;
	rr:constant nf:hasExecution .

:om_013 rdf:type rr:ObjectMap ;
	rr:template "https://w3id.org/notebookfair/execution/{id}" ;
	rr:termType rr:IRI .

